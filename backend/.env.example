# Supabase Postgres connection string (Project Settings > Database > Connection string, "Session pooler")
DATABASE_URL=postgresql://postgres:password@localhost:5432/eventbook

# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me

# Frontend origin allowed by CORS (comma-separated for several)
CORS_ORIGIN=http://localhost:3000

PORT=4000

# Used only by `npm run seed`
SEED_ADMIN_EMAIL=admin@eventbook.test
SEED_ADMIN_PASSWORD=Admin@12345
SEED_USER_EMAIL=user@eventbook.test
SEED_USER_PASSWORD=User@12345

# Used only by `npm test`. Must be a throwaway database: tests empty its tables.
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/eventbook_test
